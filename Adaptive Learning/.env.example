# Copy to .env and fill the SMTP credentials before enabling email signup.
# Gmail requires an App Password here; the Google OAuth client secret is not an SMTP password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
APP_URL=http://localhost:3000
API_URL=http://localhost:9090
FREE_EXAM_LIMIT=5
PREMIUM_PRICE=
PREMIUM_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL=
